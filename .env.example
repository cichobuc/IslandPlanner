# Skopíruj do .env.local (lokálne) a nastav v Vercel → Settings → Environment Variables.
# Nikdy necommituj skutočné hodnoty.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # len server (zakladanie kont), nikdy do klienta
# Postgres pre Drizzle (Project Settings → Database → Connection string, session pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Aplikácia ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=l.pjecha@gmail.com          # správca inštancie (zakladá kontá)
CRON_SECRET=                            # Vercel Cron → Authorization: Bearer

# --- Konektory (docs/04) ---
TRAVELPAYOUTS_TOKEN=                    # Flight Data API v1
TRAVELPAYOUTS_MARKER=
ORS_API_KEY=                            # OpenRouteService (route_matrix skript, vlastné miesta)
RESEND_API_KEY=                         # e-maily s dočasným heslom
RESEND_FROM=Island Planner <noreply@example.com>
VIATOR_API_KEY=                         # v1.1

# Feature flagy pre neoficiálne konektory (≤ 1 req/s)
FLAG_WIZZ=false
FLAG_RYANAIR=false
FLAG_GFLIGHTS=false
